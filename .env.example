# MedSIEM Environment Configuration — EXAMPLE FILE
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security — REQUIRED: generate a strong random key (e.g. openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL) — REQUIRED
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=medsiem_user
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=medsiem_db

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO S3 Object Storage — REQUIRED
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=medsiem_minio_admin
MINIO_SECRET_KEY=CHANGE_ME_strong_minio_secret_key

# Web Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# SMTP & Email Service Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@medsiem.org
SMTP_FROM_NAME="MedSIEM Healthcare SOC"
SMTP_USE_TLS=False

# Email Verification & MFA Settings
REQUIRE_EMAIL_VERIFICATION=False
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
MFA_OTP_EXPIRE_MINUTES=5
MFA_MAX_OTP_ATTEMPTS=5
